---
const navItems = [
  {
    label: "GALLERY",
    href: "/gallery/nature",
    children: [
      { label: "Nature", href: "/gallery/nature" },
      { label: "People", href: "/gallery/people" },
      { label: "Cubes", href: "/gallery/cubes" },
      { label: "Before", href: "/gallery/before" },
    ],
  },
  {
    label: "ABOUT",
    href: "/about/bio",
    children: [
      { label: "CV", href: "/about/cv" },
      { label: "Bio", href: "/about/bio" },
    ],
  },
  { label: "CONTACT", href: "/contact" },
];

const pathname = Astro.url.pathname;
---

<nav class="nav">
  <ul class="nav-list">
    {navItems.map((item) => (
      <li class={`nav-item${item.children ? " has-dropdown" : ""}`}>
        <a
          href={item.href}
          class={`nav-link${pathname.startsWith(item.href.split("/").slice(0, 2).join("/")) ? " active" : ""}`}
        >
          {item.label}
          {item.children && <span class="caret">▾</span>}
        </a>
        {item.children && (
          <ul class="dropdown">
            {item.children.map((child) => (
              <li>
                <a
                  href={child.href}
                  class={`dropdown-link${pathname === child.href ? " active" : ""}`}
                >
                  {child.label}
                </a>
              </li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ul>
</nav>
