---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="CV">
  <div class="content-page">
    <h1>CV</h1>

    <div class="prose">
      <h2>International &amp; Out-of-State Exhibitions</h2>
      <ul>
        <li>2025 February 20–23 — The Other Art Fair Los Angeles</li>
        <li>2024 October 16–20 — Affordable Art Fair, Battersea, London</li>
      </ul>

      <h2>Washington State Exhibitions</h2>
      <ul>
        <li>2026 March 26 – May 16 — <em>Water Ways: Healing the circle of water and life</em>, Schack Art Center, Everett WA</li>
        <li>2026 January 1–23 — January Show, A/NT Gallery, Seattle WA</li>
        <li>2025 December 2–26 — December Show, A/NT Gallery, Seattle WA</li>
        <li>2025 July 17–20 — Seattle Art Fair</li>
        <li>2024 July 25–28 — Seattle Art Fair</li>
        <li>2024 May 1 – June 21 — Solo exhibition <em>Between the Lines</em>, A/NT Gallery, Seattle WA</li>
      </ul>

      <h2>California Exhibitions</h2>
      <ul>
        <li>2019 March 1–28 — PAL Annual Members Exhibition, Pacific Art League, Palo Alto CA</li>
        <li>2018/2019 December 7 – January 24 — Artist Showcase 2018, Pacific Art League, Palo Alto CA</li>
        <li>2018 December 7–28 — Exhibition HARK, Kaleid Gallery, San Jose CA</li>
        <li>2018 November 2–29 — 97th Anniversary Exhibition, Pacific Art League, Palo Alto CA</li>
      </ul>

      <h2>Ukraine Exhibitions</h2>
      <ul>
        <li>2001–2015 — Various exhibitions in Odessa, Lviv, and Kyiv</li>
      </ul>

      <h2>Moldova Exhibitions</h2>
      <ul>
        <li>2001, 2003, 2004 — Gallery "Brancusi", Chisinau</li>
      </ul>
    </div>
  </div>
</Layout>

<style>
  .content-page {
    max-width: 720px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 4rem;
  }

  h1 {
    font-size: 1.75rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 2rem;
    color: var(--color-text);
  }

  .prose h2 {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin: 2rem 0 0.75rem;
    color: var(--color-text);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.4rem;
  }

  .prose ul {
    padding-left: 1.5rem;
    color: var(--color-text-light);
    line-height: 1.8;
  }

  .prose li {
    margin-bottom: 0.4rem;
  }

  .prose em {
    font-style: italic;
  }
</style>
