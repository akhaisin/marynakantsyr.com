---
import Layout from "../layouts/Layout.astro";
import { resolveUrl } from "../utils/url";
---

<Layout title="Maryna Kantsyr ART">
  <section class="hero">
    <p class="statement">
      There are three types of forms. Rounded and flowing shapes — effective in
      terms of nature. Square, rectangular, triangular — effective from the human
      point of view. And a human, who can create and destroy.
    </p>
    <p class="tagline">I like to observe life around me: Nature, People, Cubes.</p>
  </section>

  <section class="circles">
    <a href={resolveUrl("/gallery/nature")} class="circle-link">
      <div class="circle">
        <span>Nature</span>
      </div>
    </a>
    <a href={resolveUrl("/gallery/people")} class="circle-link">
      <div class="circle">
        <span>People</span>
      </div>
    </a>
    <a href={resolveUrl("/gallery/cubes")} class="circle-link">
      <div class="circle">
        <span>Cubes</span>
      </div>
    </a>
  </section>
</Layout>
