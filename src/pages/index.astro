---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Maryna Kantsyr ART">
  <section class="hero">
    <p class="statement">
      There are three types of forms. Rounded and flowing shapes — effective in
      terms of nature. Square, rectangular, triangular — effective from the human
      point of view. And a human, who can create and destroy.
    </p>
    <p class="tagline">I like to observe life around me: Nature, People, Cubes.</p>
  </section>

  <section class="circles">
    <a href="/gallery/nature" class="circle-link">
      <div class="circle">
        <span>Nature</span>
      </div>
    </a>
    <a href="/gallery/people" class="circle-link">
      <div class="circle">
        <span>People</span>
      </div>
    </a>
    <a href="/gallery/cubes" class="circle-link">
      <div class="circle">
        <span>Cubes</span>
      </div>
    </a>
  </section>
</Layout>

<style>
  .hero {
    max-width: 680px;
    margin: 4rem auto 3rem;
    padding: 0 1.5rem;
    text-align: center;
  }

  .statement {
    font-size: 1.05rem;
    color: var(--color-text-light);
    line-height: 1.8;
    margin-bottom: 1rem;
  }

  .tagline {
    font-size: 1rem;
    color: var(--color-text);
    font-style: italic;
  }

  .circles {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 3rem;
    padding: 2rem 1.5rem 5rem;
    flex-wrap: wrap;
  }

  .circle-link {
    text-decoration: none;
  }

  .circle-link:hover {
    text-decoration: none;
  }

  .circle {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-accent);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    cursor: pointer;
  }

  .circle:hover {
    transform: scale(1.06);
    box-shadow: 0 8px 24px rgba(74, 142, 194, 0.35);
  }

  .circle span {
    color: #fff;
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  @media (max-width: 640px) {
    .circle {
      width: 150px;
      height: 150px;
    }

    .circles {
      gap: 1.5rem;
    }
  }
</style>
